{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Uncle-Becky/system_prompts/plugin-suite/manifest.schema.json",
  "title": "Prompt Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "source", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["repository", "paths"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "provider": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "provenance": {
          "type": "string",
          "enum": ["public-corpus", "official", "user-authored", "derived", "unknown"]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["skills", "workflows", "tools"],
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillRef"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflowRef"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRef"
          }
        }
      }
    },
    "speechActs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/speechAct"
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routingRule"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationGate"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenUses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citationPolicy": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "skillRef": {
      "type": "object",
      "required": ["id", "description", "triggers"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        }
      }
    },
    "workflowRef": {
      "type": "object",
      "required": ["id", "description", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        }
      }
    },
    "toolRef": {
      "type": "object",
      "required": ["name", "description", "parameters"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "sourcePath": {
          "type": "string"
        }
      }
    },
    "speechAct": {
      "type": "object",
      "required": ["type", "description", "sourceSelector"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DECLARE_AUTHORITY",
            "CONSTRAIN_ACTION",
            "REQUIRE_ACTION",
            "DELEGATE_TOOL",
            "ROUTE_SKILL",
            "VERIFY_STATE",
            "PERSIST_MEMORY",
            "FORMAT_OUTPUT",
            "GUARD_CONTEXT"
          ]
        },
        "description": {
          "type": "string"
        },
        "sourceSelector": {
          "type": "string"
        }
      }
    },
    "routingRule": {
      "type": "object",
      "required": ["when", "then"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "string"
        },
        "then": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "verificationGate": {
      "type": "object",
      "required": ["id", "description", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
